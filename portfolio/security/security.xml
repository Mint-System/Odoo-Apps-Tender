<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_privilege_portfolio" model="res.groups.privilege">
        <field name="name">Portfolio</field>
        <field name="description">Portfolio and References Management</field>
        <field name="sequence">3</field>
    </record>

    <record id="group_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="group_privilege_portfolio" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="group_privilege_portfolio" />
        <field name="implied_ids" eval="[(4, ref('group_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
