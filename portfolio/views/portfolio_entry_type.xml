<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="portfolio_entry_type_form_view" model="ir.ui.view">
        <field name="name">portfolio.entry.type_view_form</field>
        <field name="model">portfolio.entry.type</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <widget
                        name="web_ribbon"
                        text="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="sequence" />
                            <field name="hex_color" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portfolio_entry_type_list_view" model="ir.ui.view">
        <field name="name">portfolio.entry.type_view_list</field>
        <field name="model">portfolio.entry.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="sequence" />
                <field name="hex_color" />
            </list>
        </field>
    </record>

    <record id="portfolio_entry_type_search_view" model="ir.ui.view">
        <field name="name">portfolio.entry.type_view_search</field>
        <field name="model">portfolio.entry.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="sequence" />
                <separator />
                <filter
                    string="Archived"
                    name="archived"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_portfolio_entry_type_view" model="ir.actions.act_window">
        <field name="name">Portfolio Entry Types</field>
        <field name="res_model">portfolio.entry.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="portfolio_entry_type_search_view" />
    </record>
</odoo>
