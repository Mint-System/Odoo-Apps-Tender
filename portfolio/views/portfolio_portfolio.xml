<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="portfolio_portfolio_form_view" model="ir.ui.view">
        <field name="name">portfolio.portfolio_portfolio_form_view</field>
        <field name="model">portfolio.portfolio</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" select="1" readonly="1" />
                    <!-- <button name="button_confirm" string="Confirm" type="object" /> -->
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <notebook>
                        <page string="General Information" name="general_info">
                            <group>
                                <group>
                                    <field name="value" />
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="portfolio_portfolio_list_view" model="ir.ui.view">
        <field name="name">portfolio.portfolio_portfolio_list_view</field>
        <field name="model">portfolio.portfolio</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="value" />
            </list>
        </field>
    </record>

    <record id="portfolio_portfolio_search_view" model="ir.ui.view">
        <field name="name">portfolio.portfolio_portfolio_search_view</field>
        <field name="model">portfolio.portfolio</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="value" />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
            </search>
        </field>
    </record>

    <record id="action_portfolio_portfolio_view" model="ir.actions.act_window">
        <field name="name">Portfolios</field>
        <field name="res_model">portfolio.portfolio</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="portfolio_portfolio_search_view" />
    </record>

    <menuitem
        id="portfolio.menu_root"
        name="Documents"
        web_icon="portfolio,static/description/icon.png"
    />
    <menuitem
        id="portfolio.menu_document"
        name="Documents"
        parent="portfolio.menu_root"
    />
    <menuitem
        id="portfolio.menu_portfolio_portfolio"
        name="Portfolios"
        parent="portfolio.menu_document"
        action="portfolio.action_portfolio_portfolio_view"
        sequence="10"
    />
</odoo>
