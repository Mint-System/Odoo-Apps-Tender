<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Demo customer -->
    <record id="demo_partner_customer" model="res.partner">
        <field name="name">Muster AG</field>
        <field name="is_company" eval="True" />
    </record>

    <!-- Demo contact person (Sales Reference Contact) -->
    <record id="demo_partner_contact" model="res.partner">
        <field name="name">Max Meister</field>
        <field name="parent_id" ref="reference.demo_partner_customer" />
        <field name="is_company" eval="False" />
    </record>

    <!-- Demo customer owner -->
    <record id="demo_partner_customer_owner" model="res.partner">
        <field name="name">Martin Müller</field>
        <field name="parent_id" ref="reference.demo_partner_customer" />
        <field name="is_company" eval="False" />
    </record>

    <!-- Demo user: Puzzle Member (Demo) -->
    <record
        id="demo_user_puzzle_member"
        model="res.users"
        context="{'no_reset_password': True}"
    >
        <field name="name">Puzzle Member (Demo)</field>
        <field name="login">odoo+demo@puzzle.ch</field>
        <field name="email">odoo+demo@puzzle.ch</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>

    <!-- Demo user: Bernhard Wyss (Puzzle Owner) -->
    <record
        id="demo_user_bernhard_wyss"
        model="res.users"
        context="{'no_reset_password': True}"
    >
        <field name="name">Bernhard Wyss</field>
        <field name="login">bernhard.wyss@puzzle.ch</field>
        <field name="email">bernhard.wyss@puzzle.ch</field>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user')])]" />
    </record>

    <!-- Demo industries: using base module standard NOGA industries -->

    <!-- Demo stages -->
    <record id="demo_stage_in_progress" model="reference.stage">
        <field name="name">In Progress</field>
        <field name="sequence" eval="1" />
    </record>
    <record id="demo_stage_in_review" model="reference.stage">
        <field name="name">In Review</field>
        <field name="sequence" eval="2" />
    </record>
    <record id="demo_stage_sales_reference" model="reference.stage">
        <field name="name">Sales Reference</field>
        <field name="sequence" eval="3" />
    </record>
    <record id="demo_stage_success_story" model="reference.stage">
        <field name="name">Success Story</field>
        <field name="sequence" eval="4" />
    </record>
    <record id="demo_stage_sales_reference_success_story" model="reference.stage">
        <field name="name">Sales Reference &amp; Success Story</field>
        <field name="sequence" eval="5" />
    </record>

    <!-- Demo service types -->
    <record id="demo_service_type_service_contract" model="reference.service.type">
        <field name="name">Service contract</field>
        <field name="sequence" eval="2" />
        <field name="active" eval="True" />
    </record>
    <record
        id="demo_service_type_service_level_agreement"
        model="reference.service.type"
    >
        <field name="name">Service Level Agreement</field>
        <field name="sequence" eval="5" />
        <field name="active" eval="True" />
    </record>
    <record
        id="demo_service_type_subscriptions_licensing"
        model="reference.service.type"
    >
        <field name="name">Subscriptions &amp; Licensing</field>
        <field name="sequence" eval="4" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_service_type_staff_leasing" model="reference.service.type">
        <field name="name">Staff Leasing</field>
        <field name="sequence" eval="1" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_service_type_project" model="reference.service.type">
        <field name="name">Project</field>
        <field name="sequence" eval="0" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_service_type_training" model="reference.service.type">
        <field name="name">Training</field>
        <field name="sequence" eval="3" />
        <field name="active" eval="True" />
    </record>

    <!-- Demo channels -->
    <record
        id="demo_channel_puzzle_ch_references_logo_banner"
        model="reference.channel"
    >
        <field name="name">puzzle.ch, references (logo banner)</field>
        <field name="sequence" eval="10" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_puzzle_ch_success_stories" model="reference.channel">
        <field name="name">puzzle.ch, success stories</field>
        <field name="sequence" eval="11" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_puzzle_ch_solutions" model="reference.channel">
        <field name="name">puzzle.ch, solutions</field>
        <field name="sequence" eval="12" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_puzzle_ch_blog_events" model="reference.channel">
        <field name="name">puzzle.ch, blog &amp; events</field>
        <field name="sequence" eval="13" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_puzzle_ch_testimonial" model="reference.channel">
        <field name="name">puzzle.ch, testimonial</field>
        <field name="sequence" eval="14" />
        <field name="active" eval="True" />
    </record>
    <record
        id="demo_channel_sales_with_approval_of_reference_text"
        model="reference.channel"
    >
        <field name="name">Sales, with approval of reference text</field>
        <field name="sequence" eval="15" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_sales_without_contact" model="reference.channel">
        <field name="name">Sales, without contact</field>
        <field name="sequence" eval="16" />
        <field name="active" eval="True" />
    </record>
    <record id="demo_channel_sales_without_prior_contact" model="reference.channel">
        <field name="name">Sales, without prior contact</field>
        <field name="sequence" eval="17" />
        <field name="active" eval="True" />
    </record>

    <!-- Demo website tag (minimum for demo reference) -->
    <record id="demo_website_tag_digital_transformation" model="reference.website.tag">
        <field name="name">Digital Transformation</field>
        <field name="active" eval="True" />
    </record>

    <!-- Demo technologies (minimum for demo reference) -->
    <record id="demo_technology_memcached" model="reference.technology">
        <field name="name">Memcached</field>
        <field name="active" eval="True" />
    </record>
    <record id="demo_technology_jenkins" model="reference.technology">
        <field name="name">Jenkins</field>
        <field name="active" eval="True" />
    </record>
    <record id="demo_technology_odoo" model="reference.technology">
        <field name="name">Odoo</field>
        <field name="active" eval="True" />
    </record>
    <record id="demo_technology_odoo_studio" model="reference.technology">
        <field name="name">Odoo Studio</field>
        <field name="active" eval="True" />
    </record>

    <!-- Demo reference -->
    <record id="demo_reference_1" model="reference.reference">
        <field name="name">Demo Referenz XY</field>
        <field name="sequence" eval="10" />
        <field name="stage_id" ref="reference.reference_stage_new" />
        <field name="customer_id" ref="reference.demo_partner_customer" />
        <field name="contact_id" ref="reference.demo_partner_contact" />
        <field name="customer_owner_id" ref="reference.demo_partner_customer_owner" />
        <field name="user_id" ref="reference.demo_user_puzzle_member" />
        <field name="puzzle_owner_id" ref="reference.demo_user_bernhard_wyss" />
        <field
            name="member_ids"
            eval="[(6, 0, [ref('reference.demo_user_puzzle_member')])]"
        />
        <field name="project_start">2025-05-01</field>
        <field name="project_end">2026-01-31</field>
        <field name="currency_id" ref="base.CHF" />
        <field name="project_volume">300000.0</field>
        <field name="project_volume_days" eval="16" />
        <field name="usage_type">generalUse</field>
        <field name="website_url">URL auf Draft / Publiziert.html</field>
        <field name="testimonial_author">Martin Muster, Leiter Bereich XY</field>
        <field
            name="industry_ids"
            eval="[(6, 0, [ref('base.res_partner_industry_P')])]"
        />
        <field
            name="technology_ids"
            eval="[(6, 0, [
                ref('reference.demo_technology_memcached'),
                ref('reference.demo_technology_jenkins'),
                ref('reference.demo_technology_odoo'),
                ref('reference.demo_technology_odoo_studio'),
            ])]"
        />
        <field
            name="website_tag_ids"
            eval="[(6, 0, [ref('reference.demo_website_tag_digital_transformation')])]"
        />
        <field
            name="service_type_ids"
            eval="[(6, 0, [ref('reference.demo_service_type_service_contract')])]"
        />
        <field
            name="sales_reference"
        ><![CDATA[<h3 data-oe-version="1.2">Ausgangslage / Herausforderung</h3><ul><li>Welche Challenges hatte der Kunde?</li> <li>Welche Kundenbedürfnisse haben das Projekt ausgelöst?&nbsp;</li></ul><h3>Lösungsansatz</h3><ul><li>Welcher Lösungsansatz wurde gewählt? Weshalb?</li><li>Wie wurden die Herausforderungen gelöst?</li></ul><h3>Arbeitspakete / Weiterentwicklung (Liste!)</h3><ul><li>Welches Leistungen, Releases, Arbeitspakete hat Puzzle erfüllt?</li></ul><h3>Rolle / Aufgabe</h3><ul><li>Welche Rolle(n) / Verantwortungen hatte Puzzle?</li></ul><h3>Nutzen / Mehrwert</h3><ul><li>Welche Nutzen / Mehrwerte konnten erreicht / geschaffen werden?</li><li>ROI, Effizienzgewinn, wirtschaftlicher Betrieb etc.?</li><li>Belegt in Form von fassbaren Werten/Zahlen.</li></ul><h3>(Kunden)</h3><ul><li>Kundenbeschrieb im Kontext des vorherigen&nbsp;Abschnitts</li></ul><h3>(Subunternehmer)</h3><ul><li>Namen der eingesetzten Subunternehme, falls relevant.</li></ul><h3>(Ergänzende Informationen)</h3><ul><li>(Links, Hinweise, historische Infos etc.)</li></ul>]]></field>
        <field
            name="success_story"
        ><![CDATA[<div data-oe-version="1.2">Titel Success Story<br>Text der Success Story (wenn freigegeben, abgeglichen mit Website)</div>]]></field>
        <field
            name="key_aspects"
        ><![CDATA[<ul data-oe-version="1.2"><li>Aspekt 1</li><li>Aspekt 2</li><li>Aspekt 3</li></ul>]]></field>
        <field
            name="testimonial"
        ><![CDATA[<div data-oe-version="1.2">Mit der Lösung von Puzzle können wir unsere Plattform wesentlich effizienter betreiben.</div>]]></field>
        <field
            name="short_reference"
        ><![CDATA[<div data-oe-version="1.2">Mit der Lösung XY wird Problem XY adressiert. Damit kann Kunden XY den&nbsp;Geschäftsprozess XY neu wesentlich, einfacher,&nbsp;effizienter&nbsp;abwickeln. Puzzle implementiert&nbsp;moderne, skalierbare Software basierend auf Technologie XY und integriert schlank Umsystem XY.</div>]]></field>
    </record>
</odoo>
