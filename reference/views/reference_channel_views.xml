<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference Channel views -->
    <record id="reference_channel_list_view" model="ir.ui.view">
        <field name="name">reference.channel_list_view</field>
        <field name="model">reference.channel</field>
        <field name="arch" type="xml">
            <list editable="bottom" multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="reference_channel_form_view" model="ir.ui.view">
        <field name="name">reference.channel_form_view</field>
        <field name="model">reference.channel</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet string="Reference Channel">
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active" />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..." />
                        </h1>
                    </div>
                    <group name="channel_main">
                        <group name="studio_group_c09226_left" />
                        <group name="studio_group_c09226_right" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reference_channel_search_view" model="ir.ui.view">
        <field name="name">reference.channel_search_view</field>
        <field name="model">reference.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Archived" name="archived_channels" domain="[('active', '=', False)]" />
                <separator />
            </search>
        </field>
    </record>

    <record id="action_reference_channel" model="ir.actions.act_window">
        <field name="name">Reference Channels</field>
        <field name="res_model">reference.channel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
