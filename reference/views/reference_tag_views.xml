<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference Tag views -->
    <record id="reference_tag_list_view" model="ir.ui.view">
        <field name="name">reference.tag_list_view</field>
        <field name="model">reference.tag</field>
        <field name="arch" type="xml">
            <list default_order="name asc">
                <field name="name" />
                <field name="write_date" optional="hide" widget="datetime" options="{'show_seconds': false, 'show_time': false}" />
                <field name="write_uid" optional="hide" widget="many2one_avatar_user" />
            </list>
        </field>
    </record>

    <record id="reference_tag_form_view" model="ir.ui.view">
        <field name="name">reference.tag_form_view</field>
        <field name="model">reference.tag</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet string="Reference Tag">
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active" />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..." />
                        </h1>
                    </div>
                    <group name="tag_main">
                        <group name="studio_group_26640d_left" />
                        <group name="studio_group_26640d_right" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="reference_tag_search_view" model="ir.ui.view">
        <field name="name">reference.tag_search_view</field>
        <field name="model">reference.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Archived" name="archived_tags" domain="[('active', '=', False)]" />
                <separator />
            </search>
        </field>
    </record>

    <record id="action_reference_tag" model="ir.actions.act_window">
        <field name="name">Reference Tags</field>
        <field name="res_model">reference.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
