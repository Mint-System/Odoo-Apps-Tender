<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference Target Group views -->
    <record id="reference_target_group_list_view" model="ir.ui.view">
        <field name="name">reference.target.group_list_view</field>
        <field name="model">reference.target.group</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="category_id" optional="show" options="{'create_name_field': 'name', 'no_create': true}" />
                <field name="display_color" optional="show" widget="color_picker" />
            </list>
        </field>
    </record>

    <record id="reference_target_group_form_view" model="ir.ui.view">
        <field name="name">reference.target.group_form_view</field>
        <field name="model">reference.target.group</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet string="Reference Target Group">
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active" />
                    <field name="active" invisible="1" />
                    <field class="oe_avatar" widget="image" name="image" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..." />
                        </h1>
                    </div>
                    <group name="target_group_main">
                        <group name="target_group_left">
                            <field name="category_id" />
                        </group>
                        <group name="target_group_right">
                            <field name="display_color" widget="color_picker" />
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Type down your notes here..." nolabel="1" colspan="2" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="reference_target_group_search_view" model="ir.ui.view">
        <field name="name">reference.target.group_search_view</field>
        <field name="model">reference.target.group</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <separator />
                <filter string="Archived" name="archived_target_groups" domain="[('active', '=', False)]" />
                <separator />
                <group name="studio_group_by" />
                <filter name="groupby_category_id" string="Category" context="{'group_by': 'category_id'}" />
            </search>
        </field>
    </record>

    <record id="action_reference_target_group" model="ir.actions.act_window">
        <field name="name">Target Groups</field>
        <field name="res_model">reference.target.group</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
