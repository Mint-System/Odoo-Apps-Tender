<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference Technology views -->
    <record id="reference_technology_list_view" model="ir.ui.view">
        <field name="name">reference.technology_list_view</field>
        <field name="model">reference.technology</field>
        <field name="arch" type="xml">
            <list default_order="name asc" multi_edit="1">
                <field name="name" />
                <field name="category_id" optional="show" />
                <field name="color" optional="show" widget="color_picker" />
                <field name="write_uid" optional="hide" widget="many2one_avatar_user" />
                <field name="write_date" optional="hide" widget="datetime" options="{'show_seconds': false, 'show_time': false}" />
            </list>
        </field>
    </record>

    <record id="reference_technology_form_view" model="ir.ui.view">
        <field name="name">reference.technology_form_view</field>
        <field name="model">reference.technology</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet string="Reference Technology">
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active" />
                    <field name="active" invisible="1" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" required="1" placeholder="Name..." />
                        </h1>
                    </div>
                    <group name="technology_main">
                        <group name="technology_left">
                            <field name="category_id" />
                            <field name="user_id" />
                        </group>
                        <group name="technology_right" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="reference_technology_search_view" model="ir.ui.view">
        <field name="name">reference.technology_search_view</field>
        <field name="model">reference.technology</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="user_id" />
                <filter string="My Technologies" name="my_technologies" domain="[('user_id', '=', uid)]" />
                <separator />
                <filter string="Archived" name="archived_technologies" domain="[('active', '=', False)]" />
                <separator />
                <filter name="groupby_user_id" string="Responsible" context="{'group_by': 'user_id'}" domain="[]" />
            </search>
        </field>
    </record>

    <record id="action_reference_technology" model="ir.actions.act_window">
        <field name="name">Technologies, Tools &amp; Methodologies</field>
        <field name="res_model">reference.technology</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
